# ev-charger-bot secrets — keep this file readable only by the service user (chmod 600).
# See docs/INSTALL.en.md (Parts A and B) for where each value comes from.

# --- Tuya cloud (only used to fetch/renew the Local Key; the bot itself works locally) ---
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_REGION=eu                 # eu | us | in | cn  (Central Europe = eu)

# --- Charger (local) ---
TUYA_DEVICE_ID=
TUYA_DEVICE_IP=192.168.1.129   # reserve this IP in your router
TUYA_VERSION=3.4               # 3.3 | 3.4 | 3.5 as printed by "python -m tinytuya scan"
TUYA_LOCAL_KEY=                # written by "python -m tools.renew_local_key"

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-100XXXXXXXXXX   # the group id (negative)
TELEGRAM_THREAD_ID=               # topic id; leave empty for the General topic / groups without topics
TELEGRAM_OWNER_ID=                # your user id; only this user may change settings
